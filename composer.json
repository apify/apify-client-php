{
    "name": "apify/apify-client",
    "description": "Official, experimental (AI-generated and AI-maintained) Apify API client for PHP: run Actors, manage storages (datasets, key-value stores, request queues), schedules, webhooks and more.",
    "type": "library",
    "keywords": [
        "apify",
        "api",
        "client",
        "actor",
        "scraping",
        "crawler",
        "automation"
    ],
    "homepage": "https://github.com/apify/apify-client-php",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Apify",
            "email": "support@apify.com",
            "homepage": "https://apify.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-hash": "*",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-client": "^1.0",
        "guzzlehttp/guzzle": "^7.5",
        "guzzlehttp/psr7": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.52",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Apify\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Apify\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}